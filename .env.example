# Server
PORT=3000
# Public base used to build returned paste URLs (the "paste.ly" domain in the docs)
BASE_URL=http://localhost:3000

# Postgres — the METADATA store (matches docker-compose.yml). Content never goes here.
DATABASE_URL="postgresql://pastebin:pastebin@localhost:55433/pastebin?schema=public"

# Redis — hot metadata + small-blob cache + view counters (optional; app runs without it)
REDIS_URL=redis://localhost:56380

# Blob store — where the LocalFileBlobStore writes gzip-compressed paste content.
# In production this becomes an S3/GCS bucket instead.
BLOB_DIR=./data/blobs

# Key generation (Base62), length in characters
KEY_LENGTH=7

# Size cap (bytes). Over this, create returns 413 Payload Too Large. Default 10 MB.
MAX_PASTE_BYTES=10485760

# Cache TTL for hot metadata/blobs, in seconds
CACHE_TTL_SECONDS=3600
# Only cache blob bytes for pastes at or below this size (bytes)
CACHEABLE_BLOB_BYTES=65536

# Rate limiting for the create endpoint (fixed window)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60

# Background workers
VIEW_FLUSH_INTERVAL_SECONDS=30
CLEANUP_INTERVAL_SECONDS=300
